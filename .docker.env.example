# Optional. Copy to .docker.env to customize the container.
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Johannesburg
# Behind HTTPS, set APP_URL=https://your-domain and secure cookies follow automatically.
# Trust only your reverse proxy addresses, not arbitrary internet clients.
# TRUSTED_PROXIES=172.20.0.0/16
# The encryption key is generated once in /data/app.key. Do not rotate it on upgrades.
# Importing an existing database: supply its ORIGINAL key on the first start.
# APP_KEY=base64:...
# If changing the host port, pass --env-file .docker.env to Docker Compose too.
MOOLA_PORT=8080
MOOLA_BIND_ADDRESS=0.0.0.0
# For compose.image.yaml only, use a real registry image with a version tag.
# MOOLA_IMAGE=ghcr.io/your-account/moola:1.0.0
